# Base URL of the API function (no trailing slash). For local dev run `pnpm --filter api dev`.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Google OAuth client IDs (Google Cloud Console → Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=yyyy.apps.googleusercontent.com
# Set to 1 to show the "dev sign-in" button that uses the API's fake Google mode.
EXPO_PUBLIC_DEV_SIGNIN=1
