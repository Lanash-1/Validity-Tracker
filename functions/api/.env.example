# Set these as environment variables on the Catalyst function (console → Functions → api → Configuration).
# Long random secret used to sign access tokens (HS256). 48+ chars.
JWT_SECRET=change-me
# Comma-separated Google OAuth client IDs allowed to sign in (Android, web, extension).
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com
# Web Push (generate once with `npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional: Expo access token if you enabled Enhanced Push Security in your Expo account.
EXPO_ACCESS_TOKEN=
# File Store folder id that holds item photos (create a folder named "item-photos" in the console).
PHOTO_FOLDER_ID=
# Allowed browser origins (comma-separated). Catalyst web client is same-origin; add localhost for dev.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
